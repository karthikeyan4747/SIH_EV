# ==============================================================================
# EV Content Transformation Engine Environment Configuration
# ==============================================================================

# LLM Provider ("groq" or "ollama")
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# Groq API Configuration
# ------------------------------------------------------------------------------
# Multiple Groq API keys can be supplied as a comma-separated list.
# The engine will automatically rotate keys (round-robin) and juggle/failover
# to the next key when a rate limit (TPM 429) or token limit is encountered.
#
# Examples:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# or
# GROQ_API_KEY=gsk_key1,gsk_key2
GROQ_API_KEY=
GROQ_API_KEYS=

# Groq Model
GROQ_MODEL=llama-3.3-70b-versatile

# Groq Free Tier TPM Budget (default: 8000)
GROQ_TPM_LIMIT=8000

# ------------------------------------------------------------------------------
# Ollama / Local Mode Configuration
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ------------------------------------------------------------------------------
# Processing & Upload Settings
# ------------------------------------------------------------------------------
PORT=8000
MAX_UPLOAD_SIZE_BYTES=268435456
